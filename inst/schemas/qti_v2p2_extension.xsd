    <!-- OPAL/ONYX stores MAXIMA programs in an unqualified value attribute. -->
    <xs:redefine schemaLocation="imsqti_v2p2.xsd">
        <xs:complexType name="CustomOperator.Type">
            <xs:complexContent>
                <xs:extension base="CustomOperator.Type">
                    <xs:attribute name="value" type="xs:string" use="optional"/>
                </xs:extension>
            </xs:complexContent>
        </xs:complexType>
    </xs:redefine>
    <!-- OPAL reassigns correct answers before response rules. The required
         setCorrectResponse separates this extension from the base rule group. -->
    <xs:redefine schemaLocation="imsqti_v2p2.xsd">
        <xs:complexType name="ResponseProcessing.Type">
            <xs:complexContent>
                <xs:extension base="ResponseProcessing.Type">
                    <xs:sequence minOccurs="0">
                        <xs:element ref="setCorrectResponse" maxOccurs="unbounded"/>
                        <xs:choice minOccurs="0" maxOccurs="unbounded">
                            <xs:element ref="xi:include" minOccurs="1" maxOccurs="1"/>
                            <xs:element ref="responseCondition" minOccurs="1" maxOccurs="1"/>
                            <xs:element ref="responseProcessingFragment" minOccurs="1" maxOccurs="1"/>
                            <xs:element ref="setOutcomeValue" minOccurs="1" maxOccurs="1"/>
                            <xs:element ref="exitResponse" minOccurs="1" maxOccurs="1"/>
                            <xs:element ref="lookupOutcomeValue" minOccurs="1" maxOccurs="1"/>
                        </xs:choice>
                    </xs:sequence>
                </xs:extension>
            </xs:complexContent>
        </xs:complexType>
    </xs:redefine>
    <!-- details is HTML block content: allow it at any position in itemBody,
         div (rqti wraps gap exercises in a div) and modalFeedback. A redefined
         type can only append to its content, so each type appends
         (details, content*)*; with the original content* this accepts details
         anywhere after the first element. -->
    <!-- details anywhere in ItemBody -->
    <xs:redefine schemaLocation="imsqti_v2p2.xsd">
        <xs:complexType name="ItemBody.Type">
            <xs:complexContent>
                <xs:extension base="ItemBody.Type">
                    <xs:sequence minOccurs="0" maxOccurs="unbounded">
                        <xs:element ref="details"/>
                        <xs:group ref="ItemBody.Content" minOccurs="0" maxOccurs="unbounded"/>
                    </xs:sequence>
                </xs:extension>
            </xs:complexContent>
        </xs:complexType>
    </xs:redefine>
    <!-- details anywhere in Div -->
    <xs:redefine schemaLocation="imsqti_v2p2.xsd">
        <xs:complexType name="Div.Type" mixed="true">
            <xs:complexContent>
                <xs:extension base="Div.Type">
                    <xs:sequence minOccurs="0" maxOccurs="unbounded">
                        <xs:element ref="details"/>
                        <xs:group ref="Div.Content" minOccurs="0" maxOccurs="unbounded"/>
                    </xs:sequence>
                </xs:extension>
            </xs:complexContent>
        </xs:complexType>
    </xs:redefine>
    <!-- details anywhere in ModalFeedback -->
    <xs:redefine schemaLocation="imsqti_v2p2.xsd">
        <xs:complexType name="ModalFeedback.Type" mixed="true">
            <xs:complexContent>
                <xs:extension base="ModalFeedback.Type">
                    <xs:sequence minOccurs="0" maxOccurs="unbounded">
                        <xs:element ref="details"/>
                        <xs:group ref="ModalFeedback.Content" minOccurs="0" maxOccurs="unbounded"/>
                    </xs:sequence>
                </xs:extension>
            </xs:complexContent>
        </xs:complexType>
    </xs:redefine>
    <!-- OPAL test settings (AssessmentTestOpal): downloadable files, and
         semicolon-separated features such as scientific-calculator. -->
    <xs:redefine schemaLocation="imsqti_v2p2.xsd">
        <xs:complexType name="AssessmentTest.Type">
            <xs:complexContent>
                <xs:extension base="AssessmentTest.Type">
                    <xs:attribute name="data-downloads" type="xs:string" use="optional"/>
                    <xs:attribute name="data-features" type="xs:string" use="optional"/>
                </xs:extension>
            </xs:complexContent>
        </xs:complexType>
    </xs:redefine>
    <!-- OPAL recalculates variables and reshuffles choices for each item
         attempt when rebuildVariables is true (rebuild_variables in rqti). -->
    <xs:redefine schemaLocation="imsqti_v2p2.xsd">
        <xs:complexType name="ItemSessionControl.Type">
            <xs:complexContent>
                <xs:extension base="ItemSessionControl.Type">
                    <xs:attribute name="rebuildVariables" type="xs:boolean" use="optional"/>
                </xs:extension>
            </xs:complexContent>
        </xs:complexType>
    </xs:redefine>
