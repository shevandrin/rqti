                            <xs:element ref="equalRounded" minOccurs="1" maxOccurs="1"/>
                            <xs:element ref="null" minOccurs="1" maxOccurs="1"/>
                            <xs:element ref="delete" minOccurs="1" maxOccurs="1"/>
                            <xs:element ref="match" minOccurs="1" maxOccurs="1"/>
