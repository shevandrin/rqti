<?xml version = "1.0" encoding = "UTF-8"?>
<xs:schema xmlns="http://www.imsglobal.org/xsd/imsqti_v2p1"
     targetNamespace="http://www.imsglobal.org/xsd/imsqti_v2p1"
     xmlns:xi="http://www.w3.org/2001/XInclude"
     xmlns:m="http://www.w3.org/1998/Math/MathML"
     xmlns:apip="http://www.imsglobal.org/xsd/apip/apipv1p0/imsapip_qtiv1p0"
     xmlns:maptol="http://bps-system.de/xsd/imsqti_ext_maptolresponse"
     xmlns:xs="http://www.w3.org/2001/XMLSchema"
     xmlns:sch="http://purl.oclc.org/dsdl/schematron"
     version="IMS QTI 2.1.1"
     elementFormDefault="qualified"
     attributeFormDefault="unqualified">
    <xs:import namespace="http://www.w3.org/XML/1998/namespace" schemaLocation="xsd/xml.xsd" />
    <xs:import namespace="http://www.w3.org/2001/XInclude" schemaLocation="xsd/XInclude.xsd" />
    <xs:import namespace="http://www.w3.org/1998/Math/MathML" schemaLocation="mathml2/mathml2.xsd" />
    <xs:import namespace="http://www.imsglobal.org/xsd/apip/apipv1p0/imsapip_qtiv1p0" schemaLocation="xsd/apipv1p0_qtiextv2p1_v1p0.xsd" />
    <xs:import namespace="http://bps-system.de/xsd/imsqti_ext_maptolresponse" schemaLocation="maptolresponse.xsd" />

    <xs:include schemaLocation="imsqti_v2p1p2.xsd"/>

    <!-- HTML5 download hints are an rqti extension, not standard QTI 2.1. -->
    <xs:redefine schemaLocation="imsqti_v2p1p2.xsd">
        <xs:complexType name="A.Type" mixed="true">
            <xs:complexContent>
                <xs:extension base="A.Type">
                    <xs:attribute name="download" type="xs:string" use="optional" />
                </xs:extension>
            </xs:complexContent>
        </xs:complexType>
    </xs:redefine>

    <!-- OPAL/ONYX stores MAXIMA programs in an unqualified value attribute. -->
    <xs:redefine schemaLocation="imsqti_v2p1p2.xsd">
        <xs:complexType name="CustomOperator.Type">
            <xs:complexContent>
                <xs:extension base="CustomOperator.Type">
                    <xs:attribute name="value" type="xs:string" use="optional"/>
                </xs:extension>
            </xs:complexContent>
        </xs:complexType>
    </xs:redefine>

    <!-- OPAL reassigns correct answers before response rules. The required
         setCorrectResponse separates this extension from the base rule group. -->
    <xs:redefine schemaLocation="imsqti_v2p1p2.xsd">
        <xs:complexType name="ResponseProcessing.Type">
            <xs:complexContent>
                <xs:extension base="ResponseProcessing.Type">
                    <xs:sequence minOccurs="0">
                        <xs:element ref="setCorrectResponse" maxOccurs="unbounded"/>
                        <xs:choice minOccurs="0" maxOccurs="unbounded">
                            <xs:element ref="xi:include"/>
                            <xs:element ref="responseCondition"/>
                            <xs:element ref="responseProcessingFragment"/>
                            <xs:element ref="setOutcomeValue"/>
                            <xs:element ref="exitResponse"/>
                            <xs:element ref="lookupOutcomeValue"/>
                        </xs:choice>
                    </xs:sequence>
                </xs:extension>
            </xs:complexContent>
        </xs:complexType>
    </xs:redefine>

    <!-- details is HTML block content: allow it at any position in itemBody,
         div (rqti wraps gap exercises in a div) and modalFeedback. A redefined
         type can only append to its content, so each type appends
         (details, content*)*; with the original content* this accepts details
         anywhere after the first element. The *.Content groups below repeat
         the original content of each type. -->
    <xs:redefine schemaLocation="imsqti_v2p1p2.xsd">
        <xs:complexType name="ItemBody.Type">
          <xs:complexContent>
            <xs:extension base="ItemBody.Type">
              <xs:sequence minOccurs="0" maxOccurs="unbounded">
                <xs:element ref="details"/>
                <xs:group ref="ItemBody.Content" minOccurs="0" maxOccurs="unbounded"/>
              </xs:sequence>
            </xs:extension>
          </xs:complexContent>
        </xs:complexType>
    </xs:redefine>

    <xs:redefine schemaLocation="imsqti_v2p1p2.xsd">
        <xs:complexType name="Div.Type" mixed="true">
          <xs:complexContent>
            <xs:extension base="Div.Type">
              <xs:sequence minOccurs="0" maxOccurs="unbounded">
                <xs:element ref="details"/>
                <xs:group ref="Div.Content" minOccurs="0" maxOccurs="unbounded"/>
              </xs:sequence>
            </xs:extension>
          </xs:complexContent>
        </xs:complexType>
    </xs:redefine>

    <xs:redefine schemaLocation="imsqti_v2p1p2.xsd">
        <xs:complexType name="ModalFeedback.Type" mixed="true">
          <xs:complexContent>
            <xs:extension base="ModalFeedback.Type">
              <xs:sequence minOccurs="0" maxOccurs="unbounded">
                <xs:element ref="details"/>
                <xs:group ref="ModalFeedback.Content" minOccurs="0" maxOccurs="unbounded"/>
              </xs:sequence>
            </xs:extension>
          </xs:complexContent>
        </xs:complexType>
    </xs:redefine>

    <!-- Redefine the ExtendedTextInteraction.Type to add the attr data-allowPaste -->
    <xs:redefine schemaLocation="imsqti_v2p1p2.xsd">
        <xs:complexType name="ExtendedTextInteraction.Type" abstract="false" mixed="false">
            <xs:complexContent>
                <xs:extension base="ExtendedTextInteraction.Type">
                    <xs:attributeGroup ref="data-allowPaste.ExtendedTextInteraction.Attr" />
                </xs:extension>
            </xs:complexContent>
        </xs:complexType>
    </xs:redefine>

    <!-- OPAL test settings (AssessmentTestOpal): downloadable files, and
         semicolon-separated features such as scientific-calculator,
         show-test-time, mark-items and keep-responses. -->
    <xs:redefine schemaLocation="imsqti_v2p1p2.xsd">
        <xs:complexType name="AssessmentTest.Type" abstract="false" mixed="false">
            <xs:complexContent>
                <xs:extension base="AssessmentTest.Type">
                    <xs:attribute name="data-downloads" type="xs:string" use="optional"/>
                    <xs:attribute name="data-features" type="xs:string" use="optional"/>
                </xs:extension>
            </xs:complexContent>
        </xs:complexType>
    </xs:redefine>

    <!-- OPAL recalculates variables and reshuffles choices for each item
         attempt when rebuildVariables is true (rebuild_variables in rqti). -->
    <xs:redefine schemaLocation="imsqti_v2p1p2.xsd">
        <xs:complexType name="ItemSessionControl.Type" abstract="false" mixed="false">
            <xs:complexContent>
                <xs:extension base="ItemSessionControl.Type">
                    <xs:attribute name="rebuildVariables" type="xs:boolean" use="optional"/>
                </xs:extension>
            </xs:complexContent>
        </xs:complexType>
    </xs:redefine>

    <!-- Redefine the MatchInteraction.Type to add the attr orientation -->
    <xs:redefine schemaLocation="imsqti_v2p1p2.xsd">
        <xs:complexType name="MatchInteraction.Type" abstract="false" mixed="false">
            <xs:complexContent>
                <xs:extension base="MatchInteraction.Type">
                    <xs:attributeGroup ref="orientation.MatchInteraction.Attr" />
                </xs:extension>
            </xs:complexContent>
        </xs:complexType>
    </xs:redefine>

    <!-- Redefine the OUL.Type (ol) to add the attr type -->
    <xs:redefine schemaLocation="imsqti_v2p1p2.xsd">
        <xs:complexType name="OUL.Type" abstract="false" mixed="false">
            <xs:complexContent>
                <xs:extension base="OUL.Type">
                    <xs:attributeGroup ref="type.OUL.Attr" />
                </xs:extension>
            </xs:complexContent>
        </xs:complexType>
    </xs:redefine>

